      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Agent 3 in the orchestrated pipeline. Model ID fetched from app_config at request time (not hard-coded). Generates designed-room image from prompt + upload + 3 reference images."
    },
    {
