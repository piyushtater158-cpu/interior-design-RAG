# n8n webhook base URL — all API calls route through this
NEXT_PUBLIC_BACKEND_URL=http://localhost:5678/webhook

# Pricing — all three are runtime-variable. Leave blank to use defaults.
# creditsFor(amountInr) = floor(amountInr / NEXT_PUBLIC_CREDIT_RATE_INR)
NEXT_PUBLIC_CREDIT_RATE_INR=5
NEXT_PUBLIC_MIN_TOPUP_INR=1000
NEXT_PUBLIC_STORAGE_MONTHLY_INR=149
