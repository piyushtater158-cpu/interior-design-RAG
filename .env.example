# Copy to .env — never commit .env

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

OPENROUTER_API_KEY=__REDACTED_OPENROUTER_API_KEY___key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ORCHESTRATOR_MODEL=google/gemini-2.5-flash
OPENROUTER_RETRIEVER_MODEL=google/gemini-2.5-flash

GEMINI_API_KEY=your_google_ai_studio_key
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key

N8N_API_KEY=your_n8n_api_jwt
N8N_API_BASE=https://your-n8n.example.com/api/v1

ADMIN_TOKEN=generate_a_long_random_admin_token
JWT_SECRET=generate_a_long_random_jwt_secret

DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
