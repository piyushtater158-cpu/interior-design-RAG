{
  "name": "auth_me",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "auth/me",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "GET /auth/me",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "auth-me"
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "mode": "list", "value": "wf_jwt_verify" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": { "authorization": "={{ $json.headers.authorization }}" }
        },
        "options": { "waitForSubWorkflow": true }
      },
      "id": "verify",
      "name": "Verify JWT",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [{
            "id": "ok",
            "leftValue": "={{ $json.ok }}",
            "rightValue": true,
            "operator": { "type": "boolean", "operation": "equals" }
          }],
          "combinator": "and"
        }
      },
      "id": "if_ok",
      "name": "Token valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 401,
        "responseBody": "={{ JSON.stringify({ error: $json.error, code: $json.code }) }}",
        "options": {}
      },
      "id": "respond_401",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 180]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/users?id=eq.{{$json.user_id}}&select=id,email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{$env.SUPABASE_SERVICE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}" },
            { "name": "Accept",        "value": "application/json" }
          ]
        },
        "options": { "timeout": 10000 }
      },
      "id": "fetch_user",
      "name": "Fetch user",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 420]
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\nlet row;\nif (Array.isArray(d)) row = d[0];\nelse if (d && d.id) row = d;\nelse if (Array.isArray(d.body)) row = d.body[0];\nelse if (d && d.body && d.body.id) row = d.body;\nif (!row) {\n  return [{ json: { _status: 404, _body: { error: 'user_not_found', code: 'not_found' } } }];\n}\nreturn [{ json: { _status: 200, _body: { user_id: row.id, email: row.email } } }];"
      },
      "id": "shape",
      "name": "Shape response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": "={{ $json._status }}",
        "responseBody": "={{ JSON.stringify($json._body) }}",
        "options": {}
      },
      "id": "respond_ok",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1440, 420]
    }
  ],
  "connections": {
    "GET /auth/me": {
      "main": [[{ "node": "Verify JWT", "type": "main", "index": 0 }]]
    },
    "Verify JWT": {
      "main": [[{ "node": "Token valid?", "type": "main", "index": 0 }]]
    },
    "Token valid?": {
      "main": [
        [{ "node": "Fetch user",  "type": "main", "index": 0 }],
        [{ "node": "Respond 401", "type": "main", "index": 0 }]
      ]
    },
    "Fetch user": {
      "main": [[{ "node": "Shape response", "type": "main", "index": 0 }]]
    },
    "Shape response": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "auth" }]
}
