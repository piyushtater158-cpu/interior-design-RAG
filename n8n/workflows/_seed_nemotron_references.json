{
  "name": "_seed_nemotron_references",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    ...$json,\n    _cfg: {\n      supabase_url:    'https://uzghfpxboktnbcbbthns.supabase.co',\n      supabase_key:    '__REDACTED_SUPABASE_SERVICE_KEY__',\n      openrouter_key:  '__REDACTED_OPENROUTER_API_KEY__',\n      openrouter_base: 'https://openrouter.ai/api/v1',\n      embed_model:     'nvidia/llama-nemotron-embed-vl-1b-v2:free'\n    }\n  }\n}];"
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$('Config').first().json._cfg.supabase_url}}/rest/v1/reference_images?select=id,source_url,source_id,caption&order=created_at.asc&limit=1000",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{$('Config').first().json._cfg.supabase_key}}" },
            { "name": "Authorization", "value": "=Bearer {{$('Config').first().json._cfg.supabase_key}}" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "fetch_refs",
      "name": "Fetch all reference_images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Flatten response into one item per reference image row.\nconst raw = $json;\nconst rows = Array.isArray(raw) ? raw : (Array.isArray(raw.body) ? raw.body : []);\nif (rows.length === 0) {\n  const hint = !Array.isArray(raw)\n    ? ' — Supabase returned: ' + JSON.stringify(raw).slice(0, 300)\n    : ' — reference_images table is empty (run the image upload/seed first)';\n  throw new Error('No reference_images found' + hint);\n}\nreturn rows.map((r, i) => ({ json: { idx: i, id: r.id, source_url: r.source_url, caption: r.caption || '' } }));"
      },
      "id": "flatten",
      "name": "One item per row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "batchSize": 3,
        "options": {}
      },
      "id": "batch",
      "name": "Batch (3/loop)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1160, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.source_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{$('Config').first().json._cfg.supabase_key}}" },
            { "name": "Authorization", "value": "=Bearer {{$('Config').first().json._cfg.supabase_key}}" }
          ]
        },
        "options": {
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "image" } },
          "timeout": 30000
        }
      },
      "id": "fetch_image",
      "name": "Fetch image bytes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build Nemotron embed request: concat caption + dataUri into ONE string (matches retrieve_references query format)\nconst cfg    = $('Config').first().json._cfg;\nconst bin    = $input.item.binary.image;\nconst b64    = bin.data;\nconst mime   = bin.mimeType || 'image/jpeg';\nconst dataUri = `data:${mime};base64,${b64}`;\nconst caption = $json.caption || '';\nreturn [{ json: {\n  ...$json,\n  openrouter_body: {\n    model: cfg.embed_model,\n    input: [ caption ? `${caption}\\n${dataUri}` : dataUri ],\n    encoding_format: 'float'\n  }\n} }];"
      },
      "id": "build_body",
      "name": "Build embed body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json._cfg.openrouter_base + '/embeddings' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$('Config').first().json._cfg.openrouter_key}}" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "HTTP-Referer",  "value": "https://interior-design-rag.local" },
            { "name": "X-Title",       "value": "Interior Design RAG — seed" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.openrouter_body) }}",
        "options": {
          "timeout": 60000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "embed",
      "name": "OpenRouter embed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1880, 300]
    },
    {
      "parameters": {
        "jsCode": "const id  = $('Build embed body').item.json.id;\nconst resp = $json;\nconst vec = (resp.data && resp.data[0] && resp.data[0].embedding) || null;\nif (!Array.isArray(vec)) {\n  return [{ json: { reference_image_id: id, embedding_type: 'nemotron-vl-1b-v2', embedding: null, _error: JSON.stringify(resp).slice(0, 500) } }];\n}\nconst literal = `[${vec.map(x => Number(x).toString()).join(',')}]`;\nreturn [{ json: { reference_image_id: id, embedding_type: 'nemotron-vl-1b-v2', embedding: literal } }];"
      },
      "id": "shape_row",
      "name": "Shape insert row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "typeValidation": "strict" },
          "conditions": [{
            "id": "has-vec",
            "leftValue": "={{ $json.embedding }}",
            "rightValue": "",
            "operator": { "type": "string", "operation": "notEmpty" }
          }],
          "combinator": "and"
        }
      },
      "id": "if_ok",
      "name": "Has embedding?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2360, 300]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{$('Config').first().json._cfg.supabase_url}}/rest/v1/reference_embeddings?reference_image_id=eq.{{$json.reference_image_id}}&embedding_type=eq.nemotron-vl-1b-v2",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{$('Config').first().json._cfg.supabase_key}}" },
            { "name": "Authorization", "value": "=Bearer {{$('Config').first().json._cfg.supabase_key}}" }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "delete_existing",
      "name": "Delete existing embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2600, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$('Config').first().json._cfg.supabase_url}}/rest/v1/reference_embeddings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{$('Config').first().json._cfg.supabase_key}}" },
            { "name": "Authorization", "value": "=Bearer {{$('Config').first().json._cfg.supabase_key}}" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "Prefer",        "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  reference_image_id: $json.reference_image_id,\n  embedding_type:     $json.embedding_type,\n  embedding:          $json.embedding\n}) }}",
        "options": { "timeout": 15000 }
      },
      "id": "insert_row",
      "name": "Insert embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2840, 220]
    },
    {
      "parameters": {
        "jsCode": "// Skipped row — keep going. Return a marker so the summary tracks failures.\nreturn [{ json: { skipped: true, reference_image_id: $json.reference_image_id, error: $json._error || 'unknown' } }];"
      },
      "id": "note_skip",
      "name": "Note skip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2600, 420]
    },
    {
      "parameters": {
        "jsCode": "// Re-enter the batch loop until drained.\nreturn $input.all();"
      },
      "id": "loop_tail",
      "name": "Loop tail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3080, 300]
    },
    {
      "parameters": {
        "jsCode": "// After Batch drains, summarise counts.\nconst rows = $input.all();\nconst ok      = rows.filter(r => !r.json.skipped).length;\nconst skipped = rows.filter(r =>  r.json.skipped).length;\nreturn [{ json: { ok, skipped, total: ok + skipped } }];"
      },
      "id": "summary",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3320, 300]
    }
  ],
  "connections": {
    "Manual trigger": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Fetch all reference_images", "type": "main", "index": 0 }]]
    },
    "Fetch all reference_images": {
      "main": [[{ "node": "One item per row", "type": "main", "index": 0 }]]
    },
    "One item per row": {
      "main": [[{ "node": "Batch (3/loop)", "type": "main", "index": 0 }]]
    },
    "Batch (3/loop)": {
      "main": [
        [{ "node": "Summary",          "type": "main", "index": 0 }],
        [{ "node": "Fetch image bytes", "type": "main", "index": 0 }]
      ]
    },
    "Fetch image bytes": {
      "main": [[{ "node": "Build embed body", "type": "main", "index": 0 }]]
    },
    "Build embed body": {
      "main": [[{ "node": "OpenRouter embed", "type": "main", "index": 0 }]]
    },
    "OpenRouter embed": {
      "main": [[{ "node": "Shape insert row", "type": "main", "index": 0 }]]
    },
    "Shape insert row": {
      "main": [[{ "node": "Has embedding?", "type": "main", "index": 0 }]]
    },
    "Has embedding?": {
      "main": [
        [{ "node": "Delete existing embedding", "type": "main", "index": 0 }],
        [{ "node": "Note skip",                 "type": "main", "index": 0 }]
      ]
    },
    "Delete existing embedding": {
      "main": [[{ "node": "Insert embedding", "type": "main", "index": 0 }]]
    },
    "Insert embedding": {
      "main": [[{ "node": "Loop tail", "type": "main", "index": 0 }]]
    },
    "Note skip": {
      "main": [[{ "node": "Loop tail", "type": "main", "index": 0 }]]
    },
    "Loop tail": {
      "main": [[{ "node": "Batch (3/loop)", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "seed" }]
}
