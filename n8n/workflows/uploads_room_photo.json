    {
      "parameters": {
        "jsCode": "// Input: verify step returned { ok, user_id, email }.\n// The original webhook payload sits on the Webhook node; its binary is named 'file'.\nconst user_id = $json.user_id;\n\nconst binary = $('POST /uploads/room-photo').item.binary || {};\n// n8n webhook v2 stores multipart files as field0, field1... so check both 'file' and 'file0'\nconst file = binary.file || binary.file0 || Object.values(binary)[0] || null;\nif (!file) {\n  return [{ json: { _error: { status: 400, body: { error: 'missing_file', code: 'invalid_file' } } } }];\n}\n\nconst mime = (file.mimeType || '').toLowerCase();\nconst allowed = { 'image/jpeg': 'jpg', 'image/jpg': 'jpg', 'image/png': 'png' };\nconst ext = allowed[mime];\nif (!ext) {\n  return [{ json: { _error: { status: 400, body: { error: 'unsupported_media_type', code: 'invalid_file_type' } } } }];\n}\n\nconst sizeBytes = Buffer.byteLength(file.data, 'base64');\nif (sizeBytes > 10 * 1024 * 1024) {\n  return [{ json: { _error: { status: 413, body: { error: 'file_too_large', code: 'file_too_large' } } } }];\n}\n\n// pure-JS UUID (no require('crypto') â€” blocked by n8n task-runner sandbox)\nconst upload_id = Array.from({length: 32}, () => (Math.random() * 16 | 0).toString(16)).join('');\nconst path = `${user_id}/${upload_id}`;\n\nreturn [{\n  json: { user_id, upload_id, ext, mime, path, storage_path: `user-uploads/${path}` },\n  binary: { file }\n}];"
      },
