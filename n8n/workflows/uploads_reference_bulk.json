      "parameters": {
        "jsCode": "const webhookItem = $('POST /uploads/reference/bulk').item.json;\nconst authItem    = $('Extract user from token').item.json;\nconst _raw = webhookItem.body || {};\nconst body = (() => {\n  const keys = Object.keys(_raw);\n  if (keys.length === 1 && String(keys[0]).trimStart().startsWith('{')) {\n    try { return JSON.parse(keys[0]); } catch(_) {}\n  }\n  return _raw;\n})();\n\nconst user_id      = authItem.user_id;\nconst bearer_token = ($('POST /uploads/reference/bulk').item.json.headers?.authorization ||\n                     $('POST /uploads/reference/bulk').item.json.headers?.Authorization || '')\n                     .replace(/^Bearer\\s+/i, '');\n\nconst VALID_STYLES = ['scandinavian','japandi','midcentury','traditional','industrial','boho'];\nconst VALID_ROOMS  = ['bedroom','kids room','dining room','kitchen','mandir','living room'];\n\nconst style_tag = (body.style_tag || '').trim();\nconst room_type = (body.room_type || '').trim();\nconst files     = Array.isArray(body.files) ? body.files : [];\n\nif (!VALID_STYLES.includes(style_tag)) {\n  return [{ json: { _error: { status: 400, body: { error: `invalid_style_tag: ${style_tag}`, code: 'invalid_request' } } } }];\n}\nif (!VALID_ROOMS.includes(room_type)) {\n  return [{ json: { _error: { status: 400, body: { error: `invalid_room_type: ${room_type}`, code: 'invalid_request' } } } }];\n}\nif (files.length === 0) {\n  return [{ json: { _error: { status: 400, body: { error: 'files_array_empty', code: 'invalid_request' } } } }];\n}\nif (files.length > 20) {\n  return [{ json: { _error: { status: 400, body: { error: 'too_many_files_max_20', code: 'invalid_request' } } } }];\n}\n\n// Rough total size check (~80 MB base64 limit)\nconst totalB64 = files.reduce((s, f) => s + (f.content_b64 || '').length, 0);\nif (Math.floor(totalB64 * 3 / 4) > 80 * 1024 * 1024) {\n  return [{ json: { _error: { status: 413, body: { error: 'payload_too_large_max_80mb', code: 'invalid_request' } } } }];\n}\n\n// Expand each file into its own item\nreturn files.map((f, idx) => ({\n  json: {\n    file_b64:     f.content_b64,\n    file_mime:    f.mime || 'image/jpeg',\n    filename:     f.filename || `file_${idx}`,\n    style_tag,\n    room_type,\n    user_id,\n    bearer_token,\n    file_index:   idx,\n  }\n}));"
      }
