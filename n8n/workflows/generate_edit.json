      "parameters": {
        "jsCode": "const depth = typeof $json === 'number' ? $json : parseInt($json, 10) || 0;\nconst ctx   = $('Shape parent').item.json;\n// Parent itself consumes depth N ancestors; this new edit adds 1 more.\n// Cap at 6 total edits below a root.\nif (depth + 1 > 6) {\n  return [{ json: { _error: { status: 400, body: { error: 'edit_chain_cap_exceeded', code: 'edit_cap_exceeded' } } } }];\n}\nreturn [{ json: { ...ctx, chain_depth: depth } }];"
