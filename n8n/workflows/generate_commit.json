    {
      "parameters": {
        "jsCode": "// Build ordered fetch list: parent input (original room), then parent output,\n// then each reference image in the order stored on the parent row.\nconst ctx   = $('Shape parent').item.json;\nconst refs  = Array.isArray($json) ? $json : ($json.body || []);\nconst byId  = {};\nrefs.forEach(r => { byId[r.id] = r.source_url; });\n\nconst urls = [ctx.parent_input_url, ctx.parent_output_url];\nfor (const id of (ctx.parent.reference_image_ids || [])) {\n  if (byId[id]) urls.push(byId[id]);\n}\nreturn urls.map((url, i) => ({ json: { ...ctx, idx: i, fetch_url: url } }));"
      },
      "id": "order_urls",
      "name": "Order fetch list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        660
