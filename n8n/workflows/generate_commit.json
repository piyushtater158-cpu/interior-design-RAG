    {
      "parameters": {
        "jsCode": "const items = $input.all();\nitems.sort((a, b) => a.json.idx - b.json.idx);\nconst parts = items.map(it => ({\n  inline_data: {\n    mime_type: it.binary.image.mimeType || 'image/png',\n    data:      it.binary.image.data\n  }\n}));\nreturn [{ json: { ...items[0].json, image_parts: parts } }];"
      },
