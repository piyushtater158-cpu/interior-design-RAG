    {
      "parameters": {
        "jsCode": "const rows   = Array.isArray($json) ? $json : ($json.body || []);\nconst parent = rows[0];\nconst ctx    = $('Validate body').item.json;\nif (!parent) {\n  return [{ json: { _error: { status: 404, body: { error: 'parent_not_found', code: 'not_found' } } } }];\n}\nif (!parent.output_image_path || !parent.input_image_path) {\n  return [{ json: { _error: { status: 400, body: { error: 'parent_incomplete', code: 'invalid_state' } } } }];\n}\n// Walk up the chain to the root to recover the original upload. Commit should\n// render from the original room photo, not from an intermediate edit output.\n// parent.input_image_path on an edit points at the previous generation's output;\n// on a draft it points at user-uploads/<uid>/<upload_id>. For commit we want\n// to combine: the ORIGINAL upload + the latest parent output + reference images.\nreturn [{ json: {\n  ...ctx,\n  parent,\n  parent_input_url:  `https://uzghfpxboktnbcbbthns.supabase.co/storage/v1/object/public/${parent.input_image_path}`,\n  parent_output_url: `https://uzghfpxboktnbcbbthns.supabase.co/storage/v1/object/public/${parent.output_image_path}`\n} }];"
      },
