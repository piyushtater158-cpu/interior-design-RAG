        "method": "GET",
        "url": "={{ $json.fetch_url }}",
        "sendHeaders": false,
        "sendBody": false,
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "image"
            }
          },
          "timeout": 30000
        }
      },
      "id": "fetch_all",
      "name": "Fetch image bytes",
      "type": "n8n-nodes-base.httpRequest",
