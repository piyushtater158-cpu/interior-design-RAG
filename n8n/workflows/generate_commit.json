    {
      "parameters": {
        "jsCode": "const _raw = $('POST /generate/commit').item.json.body || {};\nconst body = (() => {\n  const keys = Object.keys(_raw);\n  if (keys.length === 1 && String(keys[0]).trimStart().startsWith('{')) {\n    try { return JSON.parse(keys[0]); } catch (_) {}\n  }\n  return _raw;\n})();\nconst user_id = $json.user_id;\n\nconst parent_generation_id = (body.parent_generation_id || body.generation_id || '').toString().trim();\nconst session_id = body.session_id ? body.session_id.toString() : null;\n\nconst uuidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!uuidRe.test(parent_generation_id)) {\n  return [{ json: { _error: { status: 400, body: { error: 'invalid_parent_generation_id', code: 'invalid_request' } } } }];\n}\n\nreturn [{ json: { user_id, parent_generation_id, session_id, started_at_ms: Date.now() } }];"
      },
