    {
      "parameters": {
        "jsCode": "const rows = Array.isArray($json) ? $json : ($json.body || []);\nconst base = 'https://uzghfpxboktnbcbbthns.supabase.co';\nconst items = rows.map(r => ({\n  generation_id:        r.id,\n  kind:                 r.kind,\n  output_url:           r.output_image_path ? `${base}/storage/v1/object/public/${r.output_image_path}` : null,\n  parent_generation_id: r.parent_generation_id,\n  model_id:             r.model_id,\n  room_type:            r.room_type,\n  style_tag:            r.style_tag,\n  created_at:           r.created_at\n}));\nreturn [{ json: { generations: items } }];"
      },
