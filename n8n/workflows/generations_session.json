    {
      "parameters": {
        "jsCode": "const params = $('GET /generations/session/:session_id').item.json.params || {};\nconst session_id = (params.session_id || '').toString().trim();\nconst user_id    = $json.user_id;\n\nconst uuidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!uuidRe.test(session_id)) {\n  return [{ json: { _error: { status: 400, body: { error: 'invalid_session_id', code: 'invalid_request' } } } }];\n}\nreturn [{ json: { user_id, session_id } }];"
      },
