{
  "name": "wf_event_log",
  "nodes": [
    {
      "parameters": {},
      "id": "eb2fe273-f86f-49b2-9ef7-beec248b5fd4",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json;\nlet event_type = raw.event_type;\nif (!event_type) {\n  if (raw.generation_id || raw.output_url) {\n    event_type = \"generation_complete\";\n  } else if (raw.picked_reference_ids) {\n    event_type = \"agent2_complete\";\n  } else if (raw.agent_prompt || raw.criteria) {\n    event_type = \"agent1_complete\";\n  } else {\n    event_type = \"workflow_event\";\n  }\n}\nconst payload = raw.payload || (() => {\n  if (event_type === \"generation_complete\") {\n    return { generation_id: raw.generation_id, output_url: raw.output_url, latency_ms: raw.latency_ms, model_id: raw.model_id };\n  } else if (event_type === \"agent2_complete\") {\n    return { picked_reference_ids: raw.picked_reference_ids };\n  } else if (event_type === \"agent1_complete\") {\n    return { inferred_room: raw.inferred_room, style_tag: raw.style_tag, fts_search: raw.fts_search_text };\n  }\n  return {};\n})();\nreturn [{ json: { user_id: raw.user_id || null, session_id: raw.session_id || null, event_type, payload } }];"
      },
      "id": "7d21e238-e6f2-4d9d-a8bf-4ce0a6e841e7",
      "name": "Shape event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://uzghfpxboktnbcbbthns.supabase.co/rest/v1/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "__REDACTED_SUPABASE_SERVICE_KEY__" },
            { "name": "Authorization", "value": "Bearer __REDACTED_SUPABASE_SERVICE_KEY__" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "Prefer",        "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.user_id, session_id: $json.session_id, event_type: $json.event_type, payload: $json.payload }) }}",
        "options": {
          "timeout": 10000,
          "response": { "response": { "neverError": true, "fullResponse": false } }
        }
      },
