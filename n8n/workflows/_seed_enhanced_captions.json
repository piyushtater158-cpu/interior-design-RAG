{
  "name": "_seed_enhanced_captions",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    _cfg: {\n      supabase_url: $env.SUPABASE_URL || 'https://uzghfpxboktnbcbbthns.supabase.co',\n      supabase_key: $env.SUPABASE_SERVICE_KEY\n    }\n  }\n}];"
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$('Config').first().json._cfg.supabase_url}}/rest/v1/reference_images?select=id,source_url,caption,caption_enhanced&order=created_at.asc&limit=1000",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{$('Config').first().json._cfg.supabase_key}}" },
            { "name": "Authorization", "value": "=Bearer {{$('Config').first().json._cfg.supabase_key}}" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "fetch_refs",
      "name": "Fetch all reference_images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Flatten response. Skip images that already have caption_enhanced.\nconst raw  = $json;\nconst rows = Array.isArray(raw) ? raw : (Array.isArray(raw.body) ? raw.body : []);\nif (rows.length === 0) {\n  throw new Error('No reference_images found — run the image upload/seed first');\n}\nconst pending = rows.filter(r => !r.caption_enhanced);\nconsole.log(`Total: ${rows.length}. Already enhanced: ${rows.length - pending.length}. To process: ${pending.length}`);\nreturn pending.map((r, i) => ({\n  json: {\n    reference_image_id: r.id,\n    source_url:         r.source_url,\n    caption:            r.caption || '',\n    _batch_idx:         i\n  }\n}));"
      },
      "id": "flatten",
      "name": "One item per pending row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "options": { "batchSize": 1, "reset": false }
      },
      "id": "batch",
      "name": "Process one at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1160, 300]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "mode": "list", "value": "wf_enhance_caption" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "reference_image_id": "={{ $json.reference_image_id }}",
            "source_url":         "={{ $json.source_url }}",
            "caption":            "={{ $json.caption }}"
          }
        },
        "options": { "waitForSubWorkflow": true }
      },
      "id": "enhance",
      "name": "Enhance caption",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "amount": 4,
        "unit": "seconds"
      },
      "id": "rate_limit",
      "name": "Rate limit (4s)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1640, 300],
      "webhookId": "rate-limit-enhance"
    },
    {
      "parameters": {
        "jsCode": "// splitInBatches done-branch: all items processed.\n// Per-image status is visible in the n8n execution log for each 'Enhance caption' call.\nconsole.log('Enhancement seeding complete.');\nreturn [{ json: { message: 'Enhancement seeding complete. Check execution log for per-image status.' } }];"
      },
      "id": "summary",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1880, 300]
    }
  ],
  "connections": {
    "Manual trigger":              { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config":                      { "main": [[{ "node": "Fetch all reference_images", "type": "main", "index": 0 }]] },
    "Fetch all reference_images":  { "main": [[{ "node": "One item per pending row", "type": "main", "index": 0 }]] },
    "One item per pending row":    { "main": [[{ "node": "Process one at a time", "type": "main", "index": 0 }]] },
    "Process one at a time":       { "main": [[{ "node": "Enhance caption", "type": "main", "index": 0 }], [{ "node": "Summary", "type": "main", "index": 0 }]] },
    "Enhance caption":             { "main": [[{ "node": "Rate limit (4s)", "type": "main", "index": 0 }]] },
    "Rate limit (4s)":             { "main": [[{ "node": "Process one at a time", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "seed" }, { "name": "caption" }]
}
